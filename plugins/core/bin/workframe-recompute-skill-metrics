#!/usr/bin/env python3
"""
Manual fallback entry for recomputing .claude/workframe-state/skill-metrics.yaml.

Claude Code plugin bin/ should put this command on the Bash PATH, so agents do
not need to rely on ${CLAUDE_PLUGIN_ROOT} being present in ordinary Bash calls.

Usage:
    workframe-recompute-skill-metrics
    workframe-recompute-skill-metrics --window-days 14
"""

import sys
from pathlib import Path


SCRIPTS_DIR = Path(__file__).resolve().parent.parent / "scripts"
sys.path.insert(0, str(SCRIPTS_DIR))

from recompute_skill_metrics import main  # noqa: E402


if __name__ == "__main__":
    main()
